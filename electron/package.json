{
  "name": "personal-computer-use",
  "version": "1.1.4",
  "description": "Electron shell for the Personal Computer Use agent",
  "main": "main.js",
  "scripts": {
    "seed-define": "node scripts/gen-seed-define.mjs",
    "start": "electron .",
    "dist": "electron-builder --win",
    "prepare-codex": "node scripts/prepare-codex-runtime.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.159.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.anwesh.personal-computer-use",
    "productName": "Personal Computer Use",
    "directories": {
      "output": "dist"
    },
    "beforePack": "./scripts/prepare-codex-runtime.mjs",
    "files": [
      "main.js",
      "preload.js",
      "secrets-filter.js",
      "ipc-trust.js",
      "subscription-setup.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "codex-runtime",
        "to": "codex-runtime",
        "filter": [
          "codex.exe",
          "LICENSE",
          "version.txt"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "perMachine": false,
      "include": "build/subscription-installer.nsh"
    }
  }
}
