{
  "name": "personal-computer-use",
  "version": "1.0.0",
  "description": "Electron shell for the Personal Computer Use agent",
  "main": "main.js",
  "scripts": {
    "seed-define": "node scripts/gen-seed-define.mjs",
    "prebuild": "node scripts/gen-seed-define.mjs",
    "predist": "node scripts/gen-seed-define.mjs",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.anwesh.personal-computer-use",
    "productName": "Personal Computer Use",
    "directories": {
      "output": "dist"
    },
    "beforePack": "./scripts/gen-seed-define.mjs",
    "afterAllArtifactBuild": "./scripts/cleanup-seed-define.mjs",
    "files": [
      "main.js",
      "preload.js",
      "secrets-filter.js",
      "ipc-trust.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  }
}
